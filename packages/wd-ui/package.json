{
  "name": "@webdrops/wd-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Webdrops UI component library — shared React components for all webdrops apps",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "vite build",
