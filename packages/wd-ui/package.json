  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^24.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.1.3",
    "vite": "^4.3.9",
    "vite-plugin-dts": "^3.6.4",
    "vitest": "^2.1.9"
