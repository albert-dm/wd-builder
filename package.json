{
  "name": "webdrops",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Webdrops monorepo — pluggable React page builder and component library",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "test:coverage": "turbo test -- --coverage",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albert-dm/wd-builder.git"
  },
  "author": "albert-dm",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/albert-dm/wd-builder/issues"
  },
  "homepage": "https://github.com/albert-dm/wd-builder#readme",
  "keywords": ["builder", "react", "lowcode", "webdrops"],
  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "husky": "^9.1.7",
    "turbo": "^2.5.0",
    "typescript": "^5.1.3"
  }
}